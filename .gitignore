# Dependencies
node_modules/
.pnpm-store/

# Build output and caches
.next/
.next-*/
.turbo/
out/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts

# Environment: only the example is committed
.env*
!.env.example

# Test output and evidence
evidence/
playwright-report/
test-results/
blob-report/
.playwright-mcp/

# Golden PDF corpus: commit READMEs, scripts, the manifest and generated/ only
/fixtures/pdfs/**
!/fixtures/pdfs/**/
!/fixtures/pdfs/**/README.md
!/fixtures/pdfs/*.mjs
!/fixtures/pdfs/*.ts
!/fixtures/pdfs/manifest.json
!/fixtures/pdfs/generated/**

# Local credential scratch file at the repo root (never commit)
/pass

# OS and editor
.DS_Store
Thumbs.db
*.pem
.vercel
npm-debug.log*
.pnpm-debug.log*

# Agent worktrees
.claude/worktrees/

# Supabase Postgres CA certificate (public, but kept local)
*.crt

# Copied from pdfjs-dist by apps/web/scripts/copy-pdfjs-assets.mjs
/apps/web/public/pdfjs/
# Copied by `powersync-web copy-assets` (apps/web dev/build scripts)
/apps/web/public/@powersync/

# Built by apps/web/scripts/build-sw.mjs
/apps/web/public/sw.js
/apps/web/public/offline-assets.json
