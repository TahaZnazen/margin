# Copy to apps/web/.env.local (git-ignored) and fill in the values of the DEV project, `margin-dev`.
# Local development, integration tests, E2E and CI all use margin-dev. Production values live only
# in Vercel (P12). Never commit real values, and never paste them into a chat.
#
# Supabase dashboard: https://supabase.com/dashboard → project margin-dev

# Project URL, e.g. https://<project-ref>.supabase.co
# Where: the "Connect" button at the top of the project, or Project Settings → Data API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe in the browser: RLS protects the data.
# Where: Project Settings → API Keys → "Publishable key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). Server only: it bypasses RLS. Never give it a NEXT_PUBLIC_ prefix.
# Where: Project Settings → API Keys → "Secret keys" → reveal and copy the default key.
SUPABASE_SECRET_KEY=

# Postgres connection string, server and tooling only (migrations, integration tests, scripts).
# Use the SESSION POOLER string: it works over IPv4 (GitHub Actions has no IPv6) and supports
# everything drizzle-kit migrate needs. Replace [YOUR-PASSWORD] with the database password.
# Where: the "Connect" button at the top of the project → "Connection String" → Method: "Session
# pooler" (postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres).
# Forgot the password? Project Settings → Database → "Reset database password".
DATABASE_URL=

# Supabase's root CA certificate. Supabase's Postgres certificate chains to Supabase's own CA,
# which Node doesn't trust by default, and we never turn TLS verification off.
# Value: either a path to the downloaded file (keep it outside the repo or git-ignored, e.g.
# C:/dev/secrets/supabase-ca.crt) or the PEM text itself (what the CI secret holds).
# Where: Project Settings → Database → "SSL Configuration" → "Download certificate".
DATABASE_CA_CERT=

# Password of the `powersync_role` database role. Only `pnpm db:powersync-role` reads it (once,
# when connecting PowerSync in P06). Generate 32+ random characters; PowerSync's dashboard needs
# the same value. Not needed by the app, tests or CI.
POWERSYNC_DB_PASSWORD=
