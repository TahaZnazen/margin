      "checkConstraints": {
        "annotations_kind_check": {
          "name": "annotations_kind_check",
          "value": "\"annotations\".\"kind\" in ('highlight', 'area', 'bookmark', 'ink')"
        },
        "annotations_color_check": {
          "name": "annotations_color_check",
          "value": "\"annotations\".\"color\" in ('key', 'definition', 'example', 'memorize', 'confusing')"
        },
        "annotations_anchor_status_check": {
          "name": "annotations_anchor_status_check",
          "value": "\"annotations\".\"anchor_status\" in ('anchored', 'reanchored', 'orphaned')"
        },
        "annotations_highlight_check": {
          "name": "annotations_highlight_check",
          "value": "\"annotations\".\"kind\" <> 'highlight' or (\"annotations\".\"color\" is not null and \"annotations\".\"quote_text\" is not null and \"annotations\".\"quote_text\" <> '')"
        },
        "annotations_area_check": {
          "name": "annotations_area_check",
          "value": "\"annotations\".\"kind\" <> 'area' or \"annotations\".\"quote_text\" is null"
        },
        "annotations_bookmark_check": {
          "name": "annotations_bookmark_check",
          "value": "\"annotations\".\"kind\" <> 'bookmark' or (\"annotations\".\"color\" is null and \"annotations\".\"quote_text\" is null)"
        },
        "annotations_target_check": {
          "name": "annotations_target_check",
          "value": "case\n        when \"annotations\".\"kind\" = 'ink' then jsonb_typeof(\"annotations\".\"target\") = 'object'\n        when coalesce(jsonb_typeof(\"annotations\".\"target\" -> 'segments'), '') <> 'array'\n          or coalesce(jsonb_typeof(\"annotations\".\"target\" #> '{segments,0,rects}'), '') <> 'array'\n          then false\n        else (\"annotations\".\"target\" #>> '{segments,0,page}') = \"annotations\".\"page_start\"::text\n          and case \"annotations\".\"kind\"\n            when 'highlight' then \"annotations\".\"target\" ? 'quote'\n              and jsonb_array_length(\"annotations\".\"target\" #> '{segments,0,rects}') >= 1\n            when 'area' then not (\"annotations\".\"target\" ? 'quote')\n              and jsonb_array_length(\"annotations\".\"target\" -> 'segments') = 1\n              and jsonb_array_length(\"annotations\".\"target\" #> '{segments,0,rects}') = 1\n            else not (\"annotations\".\"target\" ? 'quote')\n              and jsonb_array_length(\"annotations\".\"target\" -> 'segments') = 1\n              and jsonb_array_length(\"annotations\".\"target\" #> '{segments,0,rects}') <= 1\n          end\n      end"
        }
      },
      "isRLSEnabled": false
    },
