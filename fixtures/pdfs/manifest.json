  "conventions": {
    "paths": "file is relative to fixtures/pdfs. downloads/ and generated-large/ are git-ignored; generated/ is committed.",
    "coordinates": "pageIndex is 0-based. rect is [x0, top, x1, bottom] in PDF points relative to the page CropBox, unrotated, origin top-left (docs/ARCHITECTURE.md §4).",
